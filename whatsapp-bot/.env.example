# Copie este arquivo para ".env" (só para testar no computador).
# Na hospedagem (Render), preencha estes valores na tela de "Environment".

# Chave da IA - pegue em console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# Dados do WhatsApp - pegue em developers.facebook.com > seu app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Senha que VOCÊ inventa e repete na tela de Webhook da Meta
WHATSAPP_VERIFY_TOKEN=invente-uma-senha-aqui

# "App secret" - developers.facebook.com > seu app > Configurações do app > Básico
META_APP_SECRET=

# Seu número pessoal, só dígitos com DDI e DDD (ex: 5511999998888).
# Recebe os avisos quando um aluno pede para falar com você.
PROFESSOR_TELEFONE=

# Opcionais
CLAUDE_MODEL=claude-opus-5-5
PAUSA_HORAS=12
LIMITE_POR_HORA=30
GRAPH_API_VERSION=v23.0
PORT=3000
